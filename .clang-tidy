---
# kvdb 项目的 .clang-tidy 配置文件
# 此配置旨在实现现代化、安全且可读的 C++ 代码。
# 它基于广泛的检查并根据我们的特定需求进行了定制。

# 'Checks' 定义了启用和禁用的静态分析检查。
# 总体策略是启用广泛的类别，然后单独禁用特定的、
# 嘈杂的或无用的检查。
Checks: >
  -*,                   # 1. 首先禁用所有检查。
  bugprone-*,           # 2. 启用我们关心的检查类别。
  cert-*,               # 检查 CERT C++ 安全编码标准。
  cppcoreguidelines-*,  # 检查 C++ 核心指南。
  clang-analyzer-*,     # 来自 Clang 静态分析器的深度静态分析。
  google-*,             # 检查 Google C++ 风格指南规则。
  hicpp-*,              # 检查高完整性 C++ 编码标准。
  misc-*,               # 其他有用的杂项检查。
  modernize-*,          # 检查 C++ 代码的现代化（例如，升级到 C++11/14/17/20）。
  performance-*,        # 检查性能反模式。
  portability-*,        # 检查可移植性问题。
  readability-*         # 检查代码可读性。
  -modernize-use-trailing-return-type, # 尾随返回类型通常是风格问题，而非必要。
  -google-readability-todo,            # 允许使用 TODO 注释而无需特定格式。
  -readability-identifier-length,      # 允许使用像 'i', 'db', 'fd' 这样的短标识符，这些很常见。
  -readability-magic-numbers,          # 目前禁用，但可能有用。如果需要严格性，可以启用。
  -hicpp-special-member-functions,     # 可能过于冗长，尤其是在使用默认成员时。
  -cppcoreguidelines-special-member-functions, # 与上面类似。
  
  # --- 基于我们的日志记录器实现的重要补充 ---
  -cppcoreguidelines-macro-usage,      # 全局禁用此项，因为我们有合理的宏使用。
                                       # 或者，您可以保持启用状态并在代码中使用 NOLINT。
                                       # 对于像日志记录这样的项目范围内的习惯用法，在此处禁用更清晰。
  -cppcoreguidelines-avoid-do-while    # 禁用标记我们安全的 do-while(false) 宏习惯用法的检查。


# 'WarningsAsErrors' 可用于将 clang-tidy 的所有警告视为错误，
# 强制修复它们。这对于 CI/CD 环境很有用。
# 示例: 'bugprone-*,performance-*'
WarningsAsErrors: ''

# 'HeaderFilterRegex' 将检查限制在与此正则表达式匹配的头文件。
# 设置为 '.*' 会检查所有包含的头文件。对于项目特定的代码，
# 您可能希望缩小范围，例如 '^(kvdb)/.*'。
HeaderFilterRegex: '.*'

# 'ExtraArgs' 允许向编译器传递额外的命令行参数。
# 这对于设置 C++ 标准至关重要。
ExtraArgs:
  - -std=c++20 # 如果您尚未使用 C++20 功能，则使用 c++17。

# 'CheckOptions' 允许微调特定检查的行为。
CheckOptions:
  # --- 命名约定 (从您的原始文件自定义) ---
  - { key: readability-identifier-naming.ClassCase,           value: CamelCase }
  - { key: readability-identifier-naming.StructCase,          value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,            value: CamelCase }
  - { key: readability-identifier-naming.NamespaceCase,       value: lower_case }
  - { key: readability-identifier-naming.FunctionCase,        value: camelBack }
  - { key: readability-identifier-naming.VariableCase,        value: camelBack }
  - { key: readability-identifier-naming.PrivateMemberSuffix, value: _ } # 表示私有成员的好习惯。
  - { key: readability-identifier-naming.ConstantCase,        value: UPPER_CASE } # 用于全局/静态常量。
  - { key: readability-identifier-naming.EnumConstantCase,    value: kCamelCase } # Google 风格 (例如, kOk, kError)。如果您更喜欢，也可以坚持使用 UPPER_CASE。
  
  # --- 其他重要选项 ---
  - { key: readability-implicit-bool-conversion.AllowIntegerConditions,  value: 1 } # 允许 `if (count)`
  - { key: readability-implicit-bool-conversion.AllowPointerConditions,  value: 1 } # 允许 `if (ptr)`

  # --- 推荐的补充 ---
  - { key: modernize-use-emplace.ContainerSet, value: 'std::vector;std::list;std::deque' } # 指定哪些容器应优先使用 emplace。
  - { key: modernize-use-override.AllowOverrideAndFinal, value: 1 } # 在虚方法上强制使用 'override' 或 'final'。
  - { key: performance-unnecessary-value-param.AllowedTypes, value: 'trivial_string_view;QVariant' } # 添加复制成本低的类型。
